{
  "name": "spellpath-extension",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "VITE_EDITION=byok node scripts/build-extension.mjs",
    "build:byok": "VITE_EDITION=byok node scripts/build-extension.mjs",
    "build:byok:unpacked": "VITE_EDITION=byok SPELLPATH_UNPACKED_OAUTH=1 node scripts/build-extension.mjs",
    "build:byok:share": "VITE_EDITION=byok SPELLPATH_SHARE_ZIP=1 node scripts/build-extension.mjs",
    "build:consumer": "VITE_EDITION=consumer node scripts/build-extension.mjs",
    "build:local": "VITE_EDITION=byok VITE_API_BASE=http://localhost:4000 SPELLPATH_UNPACKED_OAUTH=1 node scripts/build-extension.mjs",
    "build:local:consumer": "VITE_EDITION=consumer VITE_API_BASE=http://localhost:4000 node scripts/build-extension.mjs",
    "api": "node server.js",
    "test": "node --test \"server/**/*.test.js\"",
    "lint": "eslint .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "@google/generative-ai": "^0.24.1",
    "dotenv": "^17.2.3",
    "express": "^4.21.2",
    "openai": "^4.79.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "stripe": "^22.6.2"
  },
  "devDependencies": {
    "@eslint/js": "^9.25.0",
    "@tailwindcss/postcss": "^4.1.10",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@vitejs/plugin-react": "^6.0.2",
    "autoprefixer": "^10.4.21",
    "eslint": "^9.25.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.19",
    "globals": "^16.0.0",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.1",
    "vite": "^8.0.16"
  }
}
