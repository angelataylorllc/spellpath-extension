{
    "manifest_version": 3,
    "name": "Spellpath",
    "permissions": [
        "storage",
        "tabs"
    ],
    "description": "A choose-your-adventure learning tool powered by GPT.",
    "version": "0.1",
    "background": {
      "service_worker": "background.js"
    },
    "icons": {
      "48": "icon.png"
    },
    "action": {
      "default_title": "Open Spellpath",
      "default_icon": {
        "48": "icon.png"
      }
    }
  }
