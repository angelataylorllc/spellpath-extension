# Platform API keys (optional — used when the extension has no BYOK key saved)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alias for GEMINI_API_KEY

# Allow extension/clients to send BYOK headers (X-SpellPath-Provider + X-SpellPath-Api-Key)
SPELLPATH_ALLOW_BYOK=true

# Optional: log usage lines (route, provider, billingSource, token counts) to stdout
SPELLPATH_USAGE_LOG=0

# Optional model overrides (defaults shown above)
# SPELLPATH_OPENAI_MODEL=gpt-4o-mini
# SPELLPATH_ANTHROPIC_MODEL=claude-haiku-4-5
# SPELLPATH_GEMINI_MODEL=gemini-2.0-flash

# API port (optional)
# PORT=4000
