# Platform API keys (optional — used when the extension has no BYOK key saved)
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# GOOGLE_API_KEY=   # alias for GEMINI_API_KEY

# Allow extension/clients to send BYOK headers (X-SpellPath-Provider + X-SpellPath-Api-Key)
SPELLPATH_ALLOW_BYOK=true
# When the consumer zip sends no key, use this platform provider (needs that key above)
# SPELLPATH_PLATFORM_PROVIDER=anthropic

# Optional: log usage lines (route, provider, billingSource, token counts) to stdout
SPELLPATH_USAGE_LOG=0

# Optional model overrides (defaults shown above)
# SPELLPATH_OPENAI_MODEL=gpt-4o-mini
# SPELLPATH_ANTHROPIC_MODEL=claude-haiku-4-5
# SPELLPATH_GEMINI_MODEL=gemini-2.0-flash

# API port (optional)
# PORT=4000

# Google sign-in + friend allowlist (server)
# SPELLPATH_AUTH_REQUIRED=false
# SPELLPATH_ALLOWLIST=you@example.com,friend@example.com

# Extension prod URL + auth — copy .env.production.example → .env.production
# VITE_API_BASE=https://api.spellpath.app
# VITE_EDITION=byok
# VITE_AUTH_REQUIRED=true
# VITE_GOOGLE_OAUTH_CLIENT_ID=....apps.googleusercontent.com
