# Platform OpenAI key (mode A) — required if clients do not send BYOK header
OPENAI_API_KEY=

# Allow extension/clients to send X-SpellPath-OpenAI-Key (mode C). Set false for platform-only hosting.
SPELLPATH_ALLOW_BYOK=true

# Optional: log usage lines (route, billingSource, token counts) to stdout
SPELLPATH_USAGE_LOG=0

# API port (optional)
# PORT=4000
