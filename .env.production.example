# Copy to .env.production for prod builds (not committed — may contain OAuth client ID).
# Change VITE_API_BASE if the API hostname changes, then rebuild.
# VITE_EDITION is set by npm scripts (build:byok vs build:consumer).

VITE_API_BASE=https://api.spellpath.app
VITE_EDITION=byok
VITE_AUTH_REQUIRED=true
# Shared fallback. For two unpacked IDs, make a second Chrome-extension OAuth client
# and set the Friends one here:
VITE_GOOGLE_OAUTH_CLIENT_ID=
# VITE_GOOGLE_OAUTH_CLIENT_ID_BYOK=
# VITE_GOOGLE_OAUTH_CLIENT_ID_CONSUMER=
